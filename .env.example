# Скопируй в .env.local (этот файл в git не попадает) и поменяй значения.

# ------------------------------------------------------------------
# Пароль локального режима: работает ТОЛЬКО пока не настроен Supabase
# (пустые URL/KEY). Пароль попадает в JS-бандл, поэтому это не защита.
# ------------------------------------------------------------------
VITE_OWNER_PASSWORD=admin

# ------------------------------------------------------------------
# Supabase. Как только заполнены URL и publishable key, приложение
# автоматически переключается на базу + настоящую авторизацию.
# URL и publishable key (sb_publishable_...) не секретны:
# доступ к данным ограничивают RLS-политики (см. supabase/0001_games.sql).
# НЕ используй здесь secret key (sb_secret_...) / service_role.
# ------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email владельца (Supabase → Authentication → Users).
# Если пусто, поле email показывается в форме входа.
VITE_OWNER_EMAIL=

