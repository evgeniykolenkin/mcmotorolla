# Скопируй в .env.local (этот файл в git не попадает) и поменяй значения.

# ------------------------------------------------------------------
# ЭТАП 0 — заглушка входа владельца.
# Пароль попадает в JS-бандл, поэтому это НЕ защита, а просто заглушка,
# чтобы не отдавать кнопки редактирования случайным посетителям.
# Этап 2 заменит её настоящей авторизацией Supabase.
# ------------------------------------------------------------------
VITE_OWNER_PASSWORD=admin

# ------------------------------------------------------------------
# ЭТАП 1 — Supabase. Пока пусто: приложение работает в локальном режиме.
# URL и anon-ключ не секретны (защита данных — через RLS в базе).
# ------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
